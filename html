<!DOCTYPE html>
<html lang="id" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MMJ Digital Space | Multimedia Jurnalistik Angkatan 18</title>
    <!-- Google Fonts & Tailwind CSS CDN for rapid clean UI -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        darkBg: '#0a0a0a',
                        cardBg: '#141414',
                        cardBorder: '#262626',
                        accent: '#3b82f6',
                    },
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="style.css">
</head>
<body class="bg-darkBg text-gray-100 font-sans antialiased selection:bg-blue-500 selection:text-white">

    <!-- Header / Navbar -->
    <header class="fixed top-0 left-0 w-full z-50 bg-darkBg/80 backdrop-blur-md border-b border-cardBorder">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <a href="#" onclick="switchPage('home')" class="flex items-center space-x-3 group">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-500 flex items-center justify-center font-bold text-lg text-white shadow-lg shadow-blue-500/20 group-hover:scale-105 transition">
                    18
                </div>
                <div>
                    <span class="block font-bold text-lg tracking-tight text-white">MMJ Digital Space</span>
                    <span class="block text-xs text-gray-400">Multimedia Jurnalistik · Angkatan 18</span>
                </div>
            </a>

            <!-- Desktop Nav -->
            <nav class="hidden md:flex items-center space-x-8 text-sm font-medium text-gray-300">
                <button onclick="switchPage('home')" class="nav-link hover:text-white transition active" data-target="home">Beranda</button>
                <button onclick="switchPage('archive')" class="nav-link hover:text-white transition" data-target="archive">Memory Archive</button>
                <button onclick="switchPage('news')" class="nav-link hover:text-white transition" data-target="news">Newsroom</button>
                <button onclick="switchPage('members')" class="nav-link hover:text-white transition" data-target="members">Members Hub</button>
                <button onclick="switchPage('showcase')" class="nav-link hover:text-white transition" data-target="showcase">Design Showcase</button>
                <button onclick="switchPage('feedback')" class="nav-link hover:text-white transition" data-target="feedback">Kritik & Saran</button>
            </nav>

            <!-- Hamburger Button -->
            <button id="menu-btn" class="md:hidden p-2 rounded-lg bg-cardBg border border-cardBorder text-gray-300 hover:text-white focus:outline-none">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                </svg>
            </button>
        </div>

        <!-- Mobile Menu Overlay -->
        <div id="mobile-menu" class="hidden md:hidden absolute top-20 left-0 w-full bg-darkBg/95 backdrop-blur-xl border-b border-cardBorder px-6 py-6 space-y-4 shadow-2xl">
            <button onclick="switchPage('home'); toggleMenu();" class="block w-full text-left py-2 font-medium text-gray-300 hover:text-white">Beranda</button>
            <button onclick="switchPage('archive'); toggleMenu();" class="block w-full text-left py-2 font-medium text-gray-300 hover:text-white">Memory Archive</button>
            <button onclick="switchPage('news'); toggleMenu();" class="block w-full text-left py-2 font-medium text-gray-300 hover:text-white">Newsroom</button>
            <button onclick="switchPage('members'); toggleMenu();" class="block w-full text-left py-2 font-medium text-gray-300 hover:text-white">Members Hub</button>
            <button onclick="switchPage('showcase'); toggleMenu();" class="block w-full text-left py-2 font-medium text-gray-300 hover:text-white">Design Showcase</button>
            <button onclick="switchPage('feedback'); toggleMenu();" class="block w-full text-left py-2 font-medium text-gray-300 hover:text-white">Kritik & Saran</button>
        </div>
    </header>

    <!-- Main Container -->
    <main class="pt-28 pb-16 min-h-screen">

        <!-- 1. HOME PAGE -->
        <section id="page-home" class="page-section max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">
            <!-- Hero Section -->
            <div class="relative rounded-3xl overflow-hidden bg-gradient-to-b from-cardBg to-darkBg border border-cardBorder p-8 sm:p-16 text-center">
                <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#3b82f6_1px,transparent_1px)] [background-size:16px_16px]"></div>
                <div class="relative z-10 max-w-3xl mx-auto space-y-6">
                    <span class="inline-block py-1 px-4 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-semibold tracking-widest uppercase">
                        CAPTURE THE MOMENT, PRESERVE THE STORY
                    </span>
                    <h1 class="text-4xl sm:text-6xl font-extrabold text-white tracking-tight leading-tight">
                        Setiap momen punya cerita.
                    </h1>
                    <p class="text-gray-400 text-base sm:text-lg leading-relaxed">
                        MMJ Digital Space adalah pusat informasi, dokumentasi visual, publikasi berita, dan portofolio karya kreatif resmi Multimedia Jurnalistik Angkatan 18.
                    </p>
                    <div class="flex flex-wrap justify-center gap-4 pt-4">
                        <button onclick="switchPage('archive')" class="px-6 py-3 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-semibold transition shadow-lg shadow-blue-600/30">
                            Jelajahi Arsip
                        </button>
                        <button onclick="switchPage('news')" class="px-6 py-3 rounded-xl bg-cardBg border border-cardBorder hover:border-gray-600 text-white font-semibold transition">
                            Baca Berita Terbaru
                        </button>
                    </div>
                </div>
            </div>

            <!-- 3 Shortcuts Utama -->
            <div class="space-y-6">
                <div class="flex items-center justify-between">
                    <h2 class="text-2xl font-bold text-white tracking-tight">Akses Cepat</h2>
                    <span class="text-sm text-gray-500">Menu Utama Portal</span>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <!-- Shortcut 1 -->
                    <div onclick="switchPage('archive')" class="group p-6 rounded-2xl bg-cardBg border border-cardBorder hover:border-blue-500/50 cursor-pointer transition space-y-4">
                        <div class="w-12 h-12 rounded-xl bg-blue-500/10 flex items-center justify-center text-blue-400 group-hover:scale-110 transition">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                        </div>
                        <h3 class="text-xl font-bold text-white group-hover:text-blue-400 transition">Memory Archive</h3>
                        <p class="text-gray-400 text-sm">Penyimpanan dokumentasi foto dan video kegiatan sekolah, lomba, upacara, dan agenda angkatan.</p>
                    </div>
                    <!-- Shortcut 2 -->
                    <div onclick="switchPage('news')" class="group p-6 rounded-2xl bg-cardBg border border-cardBorder hover:border-blue-500/50 cursor-pointer transition space-y-4">
                        <div class="w-12 h-12 rounded-xl bg-purple-500/10 flex items-center justify-center text-purple-400 group-hover:scale-110 transition">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path></svg>
                        </div>
                        <h3 class="text-xl font-bold text-white group-hover:text-purple-400 transition">Newsroom</h3>
                        <p class="text-gray-400 text-sm">Portal publikasi berita, artikel, dan hasil liputan jurnalistik sekolah dengan struktur editorial rapi.</p>
                    </div>
                    <!-- Shortcut 3 -->
                    <div onclick="switchPage('members')" class="group p-6 rounded-2xl bg-cardBg border border-cardBorder hover:border-blue-500/50 cursor-pointer transition space-y-4">
                        <div class="w-12 h-12 rounded-xl bg-emerald-500/10 flex items-center justify-center text-emerald-400 group-hover:scale-110 transition">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1
